# Plantilla de variables de entorno para el entorno de desarrollo de PostgreSQL.
# Copiar este archivo como .env en la raíz del repositorio. El archivo .env se excluye del control de versiones.
# Los valores son ficticios. Reemplazar POSTGRES_PASSWORD por una credencial local antes de iniciar el entorno.

POSTGRES_DB=migal_smartops
POSTGRES_USER=migal_app
POSTGRES_PASSWORD=cambiar-este-valor
POSTGRES_PUERTO=5432

# Variables del backend. Se leen como variables de entorno al ejecutar la aplicación.
# MIGAL_JWT_SECRETO: clave de firma de los tokens, de al menos 32 caracteres.
# MIGAL_ADMIN_USERNAME y MIGAL_ADMIN_CLAVE: crean el primer Administrador si aún no existe ninguno.
# La clave debe tener al menos 8 caracteres con letras y números y conviene reemplazarla tras el primer inicio de sesión.

# Conexión del backend a Supabase (ADR-007). Dejar sin definir para usar PostgreSQL local.
# Usar el pooler en modo sesión (puerto 5432 del host aws-*.pooler.supabase.com) o la conexión directa.
# Reemplazar los marcadores con los valores del panel de Supabase (Connect). No publicar valores reales.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host-del-pooler>:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.yonwlcoahyeptdnwtesk
# SPRING_DATASOURCE_PASSWORD=<contrasena-de-la-base-de-datos>
# Solo en la primera ejecución contra Supabase: el esquema public contiene una función propia de la plataforma
# y Flyway exige una línea base. La versión 0 conserva la ejecución de V1. Retirar ambas líneas después.
# spring.flyway.baseline-on-migrate=true
# spring.flyway.baseline-version=0
