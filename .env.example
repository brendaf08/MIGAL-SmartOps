# Plantilla de variables de entorno para el entorno de desarrollo de PostgreSQL.
# Copiar este archivo como .env en la raíz del repositorio. El archivo .env se excluye del control de versiones.
# Los valores son ficticios. Reemplazar POSTGRES_PASSWORD por una credencial local antes de iniciar el entorno.

POSTGRES_DB=migal_smartops
POSTGRES_USER=migal_app
POSTGRES_PASSWORD=cambiar-este-valor
POSTGRES_PUERTO=5432
